<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>app.qingjian.Qingjian</id>
  <name>青简</name>
  <summary>输入的不只是文字</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <developer id="app.qingjian">
    <name>Qingjian</name>
  </developer>
  <description>
    <p>
      青简是一个拼音输入法：候选词旁附一条目标语言的译词，打字的同时顺带认词。
      拼音转换、词库、排序、学习与翻译全部在本机完成。
    </p>
    <p>
      这个 Flatpak 同时装了输入法引擎与设置界面。引擎由 IBus 拉起，需要在宿主机上注册一次组件描述，
      见项目文档的 Linux 安装一节。
    </p>
  </description>
  <launchable type="desktop-id">app.qingjian.Qingjian.desktop</launchable>
  <url type="homepage">https://qingjian.app</url>
  <content_rating type="oars-1.1"/>
</component>
