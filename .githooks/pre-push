#!/usr/bin/env bash
# 推之前跑全 workspace 测试（提交时不跑，太慢）；跳过：git push --no-verify
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
# qingjian-macos 只能在 Apple 平台编译，别的平台排除它（同 pre-commit）
exclude=()
[[ "$(uname -s)" == Darwin ]] || exclude=(--exclude qingjian-macos)
cargo test --workspace ${exclude[@]+"${exclude[@]}"} --locked
