#!/usr/bin/env bash
# 启用：git config core.hooksPath .githooks；跳过：git commit --no-verify
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# 装饰性分隔注释（`// ====` / `// ────`）不要：只做视觉分组、不带任何「为什么」，用空行加语义排序分组
staged_rs="$(git diff --cached --name-only --diff-filter=ACM -- '*.rs')"
if [[ -n "$staged_rs" ]]; then
  matches="$(echo "$staged_rs" | xargs grep -nE '^\s*//[/!]?\s*[=─-]{3,}\s*$' 2>/dev/null || true)"
  if [[ -n "$matches" ]]; then
    echo "$matches"
    echo "装饰性分隔注释不要，用空行 + 语义排序分组" >&2
    exit 1
  fi
fi

cargo fmt --all --check
# qingjian-macos 依赖 objc2，只能在 Apple 平台编译；别的平台跟 CI 的 Linux job 一样排除它。
# 空数组用 ${a[@]+"${a[@]}"} 展开：macOS 自带的 bash 3.2 在 set -u 下直接展开空数组会报未绑定
exclude=()
[[ "$(uname -s)" == Darwin ]] || exclude=(--exclude qingjian-macos)
cargo clippy --workspace ${exclude[@]+"${exclude[@]}"} --all-targets -- -D warnings
